Options -Indexes

RewriteEngine On

# 301: www -> bez www
RewriteCond %{HTTP_HOST} ^www\.udraznianierurwarszawa\.pl$ [NC]
RewriteRule ^(.*)$ https://udraznianierurwarszawa.pl/$1 [R=301,L]

# 301: http -> https
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://udraznianierurwarszawa.pl/$1 [R=301,L]

# 301: /index.html -> /
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ / [R=301,L]
